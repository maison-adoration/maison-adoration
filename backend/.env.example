# Copier ce fichier en « .env » et remplir les valeurs.
# Ne JAMAIS enregistrer le fichier .env dans Git.

NODE_ENV=development
PORT=5000

# --- Base de données PostgreSQL (obligatoire) ---
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/maison_adoration
# Mettre true pour une base hébergée qui exige SSL (Render, Neon, Supabase…)
DATABASE_SSL=false

# --- Connexion (obligatoire) ---
# Chaîne aléatoire d'au moins 32 caractères. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Site ---
# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,https://maison-adoration.net,https://www.maison-adoration.net
SITE_URL=https://maison-adoration.net
CURRENCY=USD
PAGE_SIZE=50

# --- Cloudinary : affiches et PDF ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maison-adoration

# --- FlexPay : paiement Mobile Money ---
FLEXPAY_MERCHANT=
# Valeur complète de l'en-tête Authorization fournie par FlexPay (ex. « Bearer eyJ… »)
FLEXPAY_TOKEN=
FLEXPAY_PAYMENT_URL=
FLEXPAY_CHECK_URL=
# Adresse publique de cette API (FlexPay y envoie la confirmation : /payments/flexpay/callback)
API_PUBLIC_URL=https://maison-adoration.onrender.com

# Import YouTube (médiathèque) : clé « YouTube Data API v3 » (console.cloud.google.com).
# Sans clé, l'import remplit le titre et la miniature ; avec, aussi la date et la durée.
YOUTUBE_API_KEY=

# --- E-mails (SMTP). Pour Gmail : smtp.gmail.com, port 465, et un « mot de passe d'application » ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Maison d'Adoration pour les Nations <maisondadoration@gmail.com>"

# --- SMS (Twilio) — facultatif ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Notifications push — générer avec : npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:maisondadoration@gmail.com

# --- Migration depuis l'ancienne base (une seule fois) ---
# MONGO_URI=
